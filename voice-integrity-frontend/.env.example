# Environment settings for voice-integrity-frontend
VITE_APP_MODE=development
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
VITE_DEV_BACKEND_WS=ws://127.0.0.1:8000/ws
VITE_DEV_RELAY_URL=http://127.0.0.1:8001
VITE_DEV_RELAY_CALLER_WS=ws://127.0.0.1:8001/ws/caller
VITE_DEV_RELAY_RECEIVER_WS=ws://127.0.0.1:8001/ws/receiver

# Production overrides (e.g. for Vercel or cloud deployment)
VITE_PROD_BACKEND_URL=https://your-api.domain.com
VITE_PROD_BACKEND_WS=wss://your-api.domain.com/ws
VITE_PROD_RELAY_URL=https://your-relay.domain.com
VITE_PROD_RELAY_CALLER_WS=wss://your-relay.domain.com/ws/caller
VITE_PROD_RELAY_RECEIVER_WS=wss://your-relay.domain.com/ws/receiver
