# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Node / frontend dependencies — voice-integrity-frontend/.gitignore only applies
# once that directory is checked out, so keep a repo-root rule too: a stale
# checkout with node_modules on disk would otherwise show thousands of
# commit-ready files.
node_modules/
.npm/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# IDEs / editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Task C local model cache (HF downloads; never commit)
realtime-backend/model_cache/

# Temporary files
*.tmp
*.temp

# Ruff
.ruff_cache/

# Pyright
.pyright/

# Secrets / private keys
*.pem
*.key

# Local configuration
config.local.*
settings.local.*

# ─── Heavy data / model files (never push these) ───────────────────────────────

# Raw dataset — audio files and zip archives
data1/
*.zip
*.tar.gz
*.flac
*.wav

# Generated manifests (re-created by fetch_*.py and build_v2_manifests.py)
# Manifests are machine-specific (absolute paths) — each team member regenerates locally
expert1/data/asvspoof_manifest.csv
expert1/data/audio/
data_pipeline/manifests/
# Scratch / debug scripts
data_pipeline/test_pq.py
data_pipeline/test_*.py

# Model checkpoints
expert1/checkpoints/
lfcc-detector/checkpoints/
ssl-detector/fairseq-a54021305d6b3c4c5959ac9395135f63202db8f1/
*.pt
*.pth
*.ckpt

# HuggingFace model cache (downloaded automatically)
~/.cache/huggingface/

# ML model checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Generated audio
*.wav
*.flac
*.mp3

